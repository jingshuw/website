@article {Liu2026.10.05.756839,
	author = {Liu, Qiyuan and Zhang, Qirui and Chen, Yilong and Du, Jin-Hong and Zhao, Siming and Wang, Jingshu},
	title = {Transcriptional perturbation effects remain structured beyond the leading global trend},
	elocation-id = {2026.10.05.756839},
	year = {2026},
	doi = {10.64898/2026.10.05.756839},
	publisher = {Cold Spring Harbor Laboratory},
	abstract = {Prior work has described a global transcriptional response to gene perturbation, with many perturbations moving cells along a common direction. We find that perturbations contribute differently to this leading global trend and that substantial organization remains beyond it, including transferable perturbation-specific effects across datasets and a common hierarchy of responsive genes across perturbations. These patterns make simple strategies surprisingly competitive even in predicting effects beyond the leading global component.Competing Interest StatementThe authors have declared no competing interest.U.S. National Science Foundation, https://ror.org/021nxhr62, DMS-2238656National Institute of General Medical Sciences, https://ror.org/04q48ey07, R35GM162500Dartmouth College, https://ror.org/049s0rh22, Munck-Pfefferkorn Grant AwardsNational Natural Science Foundation of China, https://ror.org/01h0zpd94, 12601487University of Hong Kong, https://ror.org/02zhqgq86, HKU100},
	URL = {https://www.biorxiv.org/content/early/2026/10/11/2026.10.05.756839},
	eprint = {https://www.biorxiv.org/content/early/2026/10/11/2026.10.05.756839.full.pdf},
	journal = {bioRxiv}
}
